# Microsoft Entra ID configuration for maintenance access.
# These application IDs are safe to commit. Do not put client secrets in this file:
# the SPA uses the authorization-code flow with PKCE and the API validates tokens.
VITE_TENANT_ID="b8821e87-99c8-49c1-94b7-78b745b655fb"
VITE_CLIENT_ID="0c0354ee-8190-41e3-93c7-c395750c64e2"
API_CLIENT_ID="fbfa1a9d-ddcf-4f9f-abf8-64204f5d8db3"
VITE_API_SCOPE="api://fbfa1a9d-ddcf-4f9f-abf8-64204f5d8db3/access_as_user"

# Employee-directory service, reached only by the server. Replace with the
# internal directory endpoint for the deployment environment.
EMPLOYEE_API_URL="https://employee-directory.example/api/employees"
EMPLOYEE_CACHE_TTL_SECONDS="3600"
EMPLOYEE_API_TIMEOUT_MS="10000"

# Comma-separated department prefixes eligible for maintenance access. Leave
# empty only when the employee-directory service already enforces this policy.
ALLOWED_DEPARTMENTS="制造部,车间,IE精益工程部"

# Comma-separated email addresses that become bootstrap administrators on first
# sign-in. Thereafter manage planner roles through the protected admin API.
SUPER_USER_EMAILS="admin@example.com"
